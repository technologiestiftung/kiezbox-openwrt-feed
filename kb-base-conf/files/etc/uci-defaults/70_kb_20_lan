#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# only configure boxes that were set up by 70_kb_00_init
[ -n "$(uci -q get kb.main)" ] || exit 0

### miscellaneous changes and fixes
### - use rather obscure subnet on lan to reduce collisions with wan/dhcp
uci -q batch <<-EOF
	set network.lan.ipaddr='172.23.42.1/24'
EOF
### - accept input on wan zone to allow access on local network
[ "$(uci -q get firewall.@zone[1].name)" == "wan" ] && {
	uci -q batch <<-EOF
		set firewall.@zone[1].input='ACCEPT'
	EOF
}

uci commit
exit 0
