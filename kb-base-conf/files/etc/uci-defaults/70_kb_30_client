#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# only configure boxes that were set up by 70_kb_00_init
[ -n "$(uci -q get kb.main)" ] || exit 0

dist_id="$(uci -q get kb.main.dist_id)"
box_id="$(uci -q get kb.main.box_id)"
box_ip_client="10.252.0.1"
proj_domain="$(uci -q get kbproj.main.domain)"

# setup client bridge interface
[ -z "$(uci -q get network.br_client)" ] && {
	#TODO: use OpenWRT OUI for personal device, as soon as it is available/announced
	#TODO: adding bridge ports here is device specific. work that out later
	uci -q batch <<-EOF
		set network.br_client=device
		set network.br_client.type='bridge'
		set network.br_client.name='br-client'
		add_list network.br_client.ports='lan4'
		set network.br_client.bridge_empty='1'
		set network.br_client.macaddr='32:02:6b:75:${dist_id}:${box_id}'
	EOF
}

## Setup mesh client Interface
[ -z "$(uci -q get network.mesh_client)" ] && {
	uci -q batch <<-EOF
		set network.mesh_client='interface'
		set network.mesh_client.proto='static'
		set network.mesh_client.device='br-client'
		set network.mesh_client.ipaddr='${box_ip_client}'
		set network.mesh_client.netmask='255.255.0.0'
		set network.mesh_client.defaultroute='0'
	EOF
}
## Setup mesh client dhcp
#TODO: update arbitrary client limit of 1000 to something realisitc. check for performance impact of high number of leases
[ -z "$(uci -q get dhcp.mesh_client)" ] && {
	uci -q batch <<-EOF
		set dhcp.mesh_client=dhcp
		set dhcp.mesh_client.interface='mesh_client'
		set dhcp.mesh_client.instance='client'
		set dhcp.mesh_client.start='10'
		set dhcp.mesh_client.limit='1000'
		set dhcp.mesh_client.leasetime='12h'
		set dhcp.mesh_client.netmask='255.255.0.0'
		add_list dhcp.mesh_client.dhcp_option='114,https://${proj_domain}/captive-portal/api/status'
	EOF
}

# Setup Firewall
# INFO: the firewall has to be set up before the client access point,
# so the access point is never open without it
## Mesh client zone
[ -z "$(uci -q get firewall.mesh_client)" ] && {
	#TODO: set up client wifi firewall more permissive
	uci -q batch <<-EOF
		set firewall.mesh_client=zone
		set firewall.mesh_client.name='mesh_client'
		set firewall.mesh_client.input='ACCEPT'
		set firewall.mesh_client.output='ACCEPT'
		set firewall.mesh_client.forward='REJECT'
		add_list firewall.mesh_client.network='mesh_client'
		add_list firewall.mesh_client.network='mesh_captive'
	EOF
	# add include for custom captive portal rules
	#TODO: seperate this from main/client config?
	uci -q batch <<-EOF
		set firewall.portal_rules=include
		set firewall.portal_rules.type='nftables'
		set firewall.portal_rules.path='/opt/kb-script/portal_rules.nft'
		set firewall.portal_rules.position='table-post'
	EOF
}
### Mesh client forwarding to backhaul
[ -z "$(uci -q get firewall.mesh_client_bkhl)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_client_bkhl=forwarding
		set firewall.mesh_client_bkhl.src='mesh_client'
		set firewall.mesh_client_bkhl.dest='mesh_bkhl'
	EOF
}
### Mesh client forwarding to wan
[ -z "$(uci -q get firewall.mesh_client_wan)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_client_wan=forwarding
		set firewall.mesh_client_wan.src='mesh_client'
		set firewall.mesh_client_wan.dest='wan'
	EOF
}

# Setup wireless interfaces
## Setup client access point
## TODO: We currently assume radio0 is on the 2g band. improve this to find the 2g radio and mesh there
proj_ssid="$(uci -q get kbproj.main.ssid)"
[ -n "$(uci -q get wireless.radio0)" -a "$(uci -q get wireless.radio0.band)" = "2g" ] && {
	uci -q batch <<-EOF
		set wireless.kbapclient0=wifi-iface
		set wireless.kbapclient0.device='radio0'
		set wireless.kbapclient0.mode='ap'
		set wireless.kbapclient0.ssid='${proj_ssid}'
		set wireless.kbapclient0.encryption='none'
		set wireless.kbapclient0.network='mesh_client'
		set wireless.kbapclient0.macaddr='random'
		set wireless.kbapclient0.disabled='1'
	EOF
}

uci commit
exit 0
