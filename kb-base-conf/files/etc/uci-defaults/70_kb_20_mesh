#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# only configure boxes that were set up by 70_kb_00_init
[ -n "$(uci -q get kb.main)" ] || exit 0

prefix="$(uci -q get kbproj.main.prefix)"
state="$(uci -q get kb.main.state)"
dist_id="$(uci -q get kb.main.dist_id)"
box_id="$(uci -q get kb.main.box_id)"
dist_nr="$(printf %d 0x$(uci -q get kb.main.dist_id))"
box_nr="$(printf %d 0x$(uci -q get kb.main.box_id))"

# setup batman device
[ -z "$(uci -q get network.bat0)" ] && {
	uci -q batch <<-EOF
		set network.bat0='interface'
		set network.bat0.proto='batadv'
		set network.bat0.routing_algo='BATMAN_IV'
		set network.bat0.gw_mode='off'
		set network.bat0.hop_penalty='30'
		set network.bat0.distributed_arp_table='0'
	EOF
}
# setup openwrt batman interface
[ -z "$(uci -q get network.batmesh)" ] && {
	uci -q batch <<-EOF
		set network.batmesh='interface'
		set network.batmesh.proto='batadv_hardif'
		set network.batmesh.master='bat0'
		set network.batmesh.mtu='1536'
	EOF
}
# setup main mesh bridge interface
[ -z "$(uci -q get network.br_main)" ] && {
	#TODO: use OpenWRT OUI for personal device, as soon as it is available/announced
	uci -q batch <<-EOF
		set network.br_main=device
		set network.br_main.type='bridge'
		set network.br_main.name='br-main'
		add_list network.br_main.ports='bat0'
		set network.br_main.bridge_empty='1'
		set network.br_main.macaddr='22:02:6b:75:${dist_id}:${box_id}'
	EOF
}

# Setup management VLAN
[ -z "$(uci -q get network.br_main_254)" ] && {
	uci -q batch <<-EOF
		set network.br_main_254=bridge-vlan
		set network.br_main_254.vlan='254'
		set network.br_main_254.device='br-main'
		add_list network.br_main_254.ports='bat0:t'
	EOF
}
## Setup mesh management Interface
[ -z "$(uci -q get network.mesh_mgmt)" ] && {
	uci -q batch <<-EOF
		set network.mesh_mgmt='interface'
		set network.mesh_mgmt.proto='static'
		set network.mesh_mgmt.device='br-main.254'
		set network.mesh_mgmt.ipaddr='10.254.${dist_nr}.${box_nr}'
		set network.mesh_mgmt.netmask='255.255.0.0'
		set network.mesh_mgmt.defaultroute='0'
	EOF
}

# Setup backhaul VLAN
[ -z "$(uci -q get network.br_main_253)" ] && {
	uci -q batch <<-EOF
		set network.br_main_253=bridge-vlan
		set network.br_main_253.vlan='253'
		set network.br_main_253.device='br-main'
		add_list network.br_main_253.ports='bat0:t'
	EOF
}
## Setup mesh backhaul Interface
[ -z "$(uci -q get network.mesh_bkhl)" ] && {
	uci -q batch <<-EOF
		set network.mesh_bkhl='interface'
		set network.mesh_bkhl.proto='static'
		set network.mesh_bkhl.device='br-main.253'
		set network.mesh_bkhl.ipaddr='10.253.${dist_nr}.${box_nr}'
		set network.mesh_bkhl.netmask='255.255.0.0'
	EOF
	[ "${box_nr}" == "1" ] && {
		uci -q batch <<-EOF
			set network.mesh_bkhl.defaultroute='0'
		EOF
	} || {
		uci -q batch <<-EOF
			set network.mesh_bkhl.gateway='10.253.${dist_nr}.1'
			set network.mesh_bkhl.dns='10.253.${dist_nr}.1'
			set network.mesh_bkhl.metric='1000'
		EOF
	}
}

# Setup disctict specific VLAN
[ -z "$(uci -q get network.br_main_dist)" ] && {
	uci -q batch <<-EOF
		set network.br_main_dist=bridge-vlan
		set network.br_main_dist.vlan='${dist_nr}'
		set network.br_main_dist.device='br-main'
		add_list network.br_main_dist.ports='bat0:t'
	EOF
}
## Setup mesh district Interface
box_ip_dist="10.${dist_nr}.${box_nr}.1"
[ -z "$(uci -q get network.mesh_dist)" ] && {
	uci -q batch <<-EOF
		set network.mesh_dist='interface'
		set network.mesh_dist.proto='static'
		set network.mesh_dist.device='br-main.${dist_nr}'
		set network.mesh_dist.ipaddr='${box_ip_dist}'
		set network.mesh_dist.netmask='255.255.0.0'
		set network.mesh_dist.defaultroute='0'
	EOF
}

# Setup Firewall
## Mesh management zone
[ -z "$(uci -q get firewall.mesh_mgmt)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_mgmt=zone
		set firewall.mesh_mgmt.name='mesh_mgmt'
		set firewall.mesh_mgmt.input='ACCEPT'
		set firewall.mesh_mgmt.output='ACCEPT'
		set firewall.mesh_mgmt.forward='REJECT'
		add_list firewall.mesh_mgmt.network='mesh_mgmt'
	EOF
}
## Mesh backhaul zone
[ -z "$(uci -q get firewall.mesh_bkhl)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_bkhl=zone
		set firewall.mesh_bkhl.name='mesh_bkhl'
		set firewall.mesh_bkhl.input='ACCEPT'
		set firewall.mesh_bkhl.output='ACCEPT'
		set firewall.mesh_bkhl.forward='ACCEPT'
		set firewall.mesh_bkhl.masq='1'
		add_list firewall.mesh_bkhl.network='mesh_bkhl'
	EOF
}
### Mesh backhaul forwarding to wan
[ -z "$(uci -q get firewall.mesh_bkhl_wan)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_bkhl_wan=forwarding
		set firewall.mesh_bkhl_wan.src='mesh_bkhl'
		set firewall.mesh_bkhl_wan.dest='wan'
	EOF
}
## Mesh district zone
[ -z "$(uci -q get firewall.mesh_dist)" ] && {
	uci -q batch <<-EOF
		set firewall.mesh_dist=zone
		set firewall.mesh_dist.name='mesh_dist'
		set firewall.mesh_dist.input='ACCEPT'
		set firewall.mesh_dist.output='ACCEPT'
		set firewall.mesh_dist.forward='REJECT'
		add_list firewall.mesh_dist.network='mesh_dist'
	EOF
}

# Setup wireless interfaces
## Setup mesh interface
## TODO: We currently assume radio0 is on the 2g band. improve this to find the 2g radio and mesh there
mesh_ssid="$(uci -q get kbproj.main.mesh_ssid)"
mesh_chan_2_4="$(uci -q get kbproj.main.mesh_chan_2_4)"
proj_psk="$(uci -q get kbproj.main.psk)"
[ -n "$(uci -q get wireless.radio0)" -a "$(uci -q get wireless.radio0.band)" = "2g" ] && {
	uci -q batch <<-EOF
		set wireless.radio0.channel='${mesh_chan_2_4}'
		set wireless.kbmesh0=wifi-iface
		set wireless.kbmesh0.device='radio0'
		set wireless.kbmesh0.mode='mesh'
		set wireless.kbmesh0.encryption='sae'
		set wireless.kbmesh0.mesh_id='${mesh_ssid}'
		set wireless.kbmesh0.mesh_fwding='0'
		set wireless.kbmesh0.mesh_rssi_threshold='0'
		set wireless.kbmesh0.key='${proj_psk}'
		set wireless.kbmesh0.network='batmesh'
		set wireless.kbmesh0.ifname='m-11s-0'
		set wireless.kbmesh0.macaddr='42:02:6b:75:${dist_id}:${box_id}'
		set wireless.kbapmgmt0=wifi-iface
		set wireless.kbapmgmt0.device='radio0'
		set wireless.kbapmgmt0.mode='ap'
		set wireless.kbapmgmt0.ssid='${prefix}-${state}-${dist_id}-${box_id}_mgmt'
		set wireless.kbapmgmt0.encryption='psk2'
		set wireless.kbapmgmt0.key='${proj_psk}'
		set wireless.kbapmgmt0.network='mesh_mgmt'
		set wireless.kbapmgmt0.macaddr='random'
	EOF
	# Delete default APs if needed
	uci -q del wireless.default_radio0
	uci -q del wireless.default_radio1
	# Enable wireless radio
	uci set wireless.radio0.disabled=''
}

uci commit
exit 0
